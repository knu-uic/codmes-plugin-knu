{
  "schemaVersion": 1,
  "tools": [
    {
      "name": "knu_list_notices",
      "description": "공주대학교 공지를 구조화된 메타데이터로 필터링·정렬·집계합니다. 현재 신청 가능한 공지, 목록, 개수, 마감·예정 상태 질문에 사용합니다.",
      "group": "knu_notices",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": ["장학", "수강", "취업(진로)", "행사(공모전)", "일반(기타)"]
          },
          "status": {
            "type": "string",
            "enum": ["any", "open", "upcoming", "closed"],
            "default": "any"
          },
          "time_scope": {
            "type": "string",
            "enum": ["current", "historical", "all"],
            "default": "current"
          },
          "as_of": {
            "type": "string",
            "description": "판정 기준일 yyyy-mm-dd. 생략하면 KNU 서버의 오늘 날짜"
          },
          "department": {
            "type": "string"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2200
          },
          "topic": {
            "type": "string"
          },
          "sort": {
            "type": "string",
            "enum": ["posted_at", "start_date", "end_date"],
            "default": "posted_at"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        }
      },
      "provider": {
        "type": "mcp",
        "server": "knu",
        "tool": "knu_list_notices"
      },
      "requiresApproval": true,
      "readOnly": true
    },
    {
      "name": "knu_search_notice_details",
      "description": "특정 KNU 공지의 상세 날짜·자격·절차·제출서류·첨부 근거를 임베딩과 리랭킹으로 검색합니다.",
      "group": "knu_notices",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "찾으려는 구체적인 사실이나 절차"
          },
          "major": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["장학", "수강", "취업(진로)", "행사(공모전)", "일반(기타)"]
          },
          "time_scope": {
            "type": "string",
            "enum": ["current", "historical", "all"],
            "default": "current"
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2200
          },
          "notice_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Scan 결과에서 선택한 공지 ID"
          }
        },
        "required": ["query"]
      },
      "provider": {
        "type": "mcp",
        "server": "knu",
        "tool": "knu_search_notice_details"
      },
      "requiresApproval": true,
      "readOnly": true
    },
    {
      "name": "knu_get_notice_detail",
      "description": "KNU 검색 결과의 URL로 저장된 공지 원문을 가져옵니다.",
      "group": "knu_notices",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "검색 결과에 포함된 공지 URL"
          }
        },
        "required": ["url"]
      },
      "provider": {
        "type": "mcp",
        "server": "knu",
        "tool": "knu_get_notice_detail"
      },
      "requiresApproval": true,
      "readOnly": true
    }
  ]
}
